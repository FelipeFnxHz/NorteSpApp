{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NorteSp",
  "version": "1.2.7",
  "identifier": "com.nortesp.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NorteSp Roleplay",
        "width": 1366,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0d0f16"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/FelipeFnxHz/NorteSpBot/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzOEM5NjU5NjlERkY0MjUKUldRbDlOOXBXWmFNbzdIeVBldy8xSXZPUFVoTnhqVXc3MFk2eUU4UFMybzFBNlNaYXhBOHhOTUMK"
    }
  }
}